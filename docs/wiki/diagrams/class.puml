title KubeQuest - implemented content and runtime model
class Lesson <<TypeScript type>> {
 id: string
 title: string
 learn: string[]
 paragraphs: string[]
 try: string
 why: string
 question: string
 answers: string[]
 correct: number
 code: string
}
class Mission <<TypeScript type>> {
 id: string
 domain: string
 minutes: number
 objectives: string[]
 hints: string[]
 starter: string
 solution: string
}
class Session <<TypeScript type>> {
 id: string
 missionId: string
 mode: guided | independent | timed
 status: starting | ready | submitted | error
 startedAt: number
 expiresAt: number
 deadline: number | null
}
class Lab {
 session: Session | null
 available: boolean
 busy: boolean
 start(missionId, mode, minutes)
 reset(minutes)
 stop()
 touch()
 command(command, input, timeout)
 grade()
}
class Attempt <<SQLite row>> {
 id: integer
 mission: text
 mode: text
 completed_at: integer
 seconds: integer
 results: JSON text
}
class Progress <<SQLite row>> {
 lesson: text [primary key]
 completed_at: integer
}
Lab "1" o-- "0..1" Session
Session --> Mission : missionId
Attempt --> Mission : mission
Progress --> Lesson : lesson
note bottom of Attempt
Historical records survive VM reset.
Session and tutor conversation are not persisted.
end note
@enduml
